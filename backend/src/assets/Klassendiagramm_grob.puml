@startuml ToDo_Backend_Klassendiagramm

skinparam classBackgroundColor #FFFDE7
skinparam classHeaderBackgroundColor #F9A825
skinparam classBorderColor #333333
skinparam arrowColor #333333
skinparam linetype ortho
skinparam packageBackgroundColor #FFF9C4
skinparam packageBorderColor #F57F17

' =====================
' MODELS (Datenbankmodelle)
' =====================
package "Models" {

    class User {
        + uuid: UUID
        + name: String
        + password: String
        --
        + findById(uuid): User
        + findByName(name): User
        + create(name, password): User
        + delete(uuid): void
    }

    class Project {
        + projectId: BigInt
        + creatorId: UUID
        + name: String
        + description: String
        + deadline: Date
        --
        + findById(projectId): Project
        + findByUser(userId): Project[]
        + create(creatorId, name, ...): Project
        + update(projectId, data): Project
        + delete(projectId): void
    }

    class ProjectMember {
        + projectId: BigInt
        + userId: UUID
        + permission: Bit(3)
        --
        + findByProject(projectId): ProjectMember[]
        + add(projectId, userId, permission): ProjectMember
        + updatePermission(projectId, userId, permission): void
        + remove(projectId, userId): void
    }

    class Task {
        + taskId: BigInt
        + creatorId: UUID
        + parentId: BigInt
        + projectId: BigInt
        + title: String
        + description: String
        + priority: SmallInt
        + status: SmallInt
        + deadline: Date
        --
        + findById(taskId): Task
        + findByProject(projectId): Task[]
        + findSubTasks(parentId): Task[]
        + create(projectId, creatorId, ...): Task
        + update(taskId, data): Task
        + delete(taskId): void
    }

    class TaskAssignee {
        + taskId: BigInt
        + userId: UUID
        --
        + findByTask(taskId): TaskAssignee[]
        + assign(taskId, userId): TaskAssignee
        + unassign(taskId, userId): void
    }
}

' =====================
' CONTROLLERS
' =====================
package "Controllers" {

    class AuthController {
        + register(req, res): void
        + login(req, res): void
        + logout(req, res): void
    }

    class UserController {
        + getUser(req, res): void
        + updateUser(req, res): void
        + deleteUser(req, res): void
    }

    class ProjectController {
        + getAllProjects(req, res): void
        + getProjectById(req, res): void
        + createProject(req, res): void
        + updateProject(req, res): void
        + deleteProject(req, res): void
    }

    class ProjectMemberController {
        + getMembers(req, res): void
        + addMember(req, res): void
        + updatePermission(req, res): void
        + removeMember(req, res): void
    }

    class TaskController {
        + getTasksByProject(req, res): void
        + getTaskById(req, res): void
        + getSubTasks(req, res): void
        + createTask(req, res): void
        + updateTask(req, res): void
        + deleteTask(req, res): void
    }

    class TaskAssigneeController {
        + getAssignees(req, res): void
        + assignUser(req, res): void
        + unassignUser(req, res): void
    }
}

' =====================
' ROUTES
' =====================
package "Routes" {

    class AuthRoutes {
        + POST /auth/register
        + POST /auth/login
        + POST /auth/logout
    }

    class UserRoutes {
        + GET /users/:id
        + PUT /users/:id
        + DELETE /users/:id
    }

    class ProjectRoutes {
        + GET /projects
        + GET /projects/:id
        + POST /projects
        + PUT /projects/:id
        + DELETE /projects/:id
    }

    class ProjectMemberRoutes {
        + GET /projects/:id/members
        + POST /projects/:id/members
        + PUT /projects/:id/members/:userId
        + DELETE /projects/:id/members/:userId
    }

    class TaskRoutes {
        + GET /projects/:id/tasks
        + GET /tasks/:id
        + GET /tasks/:id/subtasks
        + POST /projects/:id/tasks
        + PUT /tasks/:id
        + DELETE /tasks/:id
    }

    class TaskAssigneeRoutes {
        + GET /tasks/:id/assignees
        + POST /tasks/:id/assignees
        + DELETE /tasks/:id/assignees/:userId
    }
}

' =====================
' MIDDLEWARE
' =====================
package "Middleware" {

    class AuthMiddleware {
        + verifyToken(req, res, next): void
    }

    class PermissionMiddleware {
        + requireGuest(req, res, next): void
        + requireMitarbeiter(req, res, next): void
        + requireAdmin(req, res, next): void
    }

    class ErrorMiddleware {
        + handleError(err, req, res, next): void
        + notFound(req, res): void
    }
}

' =====================
' CONFIG / INFRA
' =====================
package "Config & Infra" {

    class Database {
        - pool: Pool
        + query(sql, params): Result
        + connect(): void
    }

    class App {
        - express: Express
        + use(middleware): void
        + listen(port): void
    }

    class Server {
        + start(): void
    }
}

' =====================
' BEZIEHUNGEN – Models
' =====================
User "1" --o{ "0..*" Project        : erstellt >
User "1" --o{ "0..*" ProjectMember  : ist Mitglied >
User "1" --o{ "0..*" Task           : erstellt >
User "1" --o{ "0..*" TaskAssignee   : bearbeitet >
Project "1" --o{ "0..*" ProjectMember : hat >
Project "1" --o{ "0..*" Task          : enthält >
Task "1" --o{ "0..*" Task             : Unteraufgabe von >
Task "1" --o{ "0..*" TaskAssignee     : zugewiesen >

' =====================
' BEZIEHUNGEN – Schichten
' =====================
AuthRoutes      --> AuthController
UserRoutes      --> UserController
ProjectRoutes   --> ProjectController
ProjectMemberRoutes --> ProjectMemberController
TaskRoutes      --> TaskController
TaskAssigneeRoutes  --> TaskAssigneeController

AuthController          --> User
UserController          --> User
ProjectController       --> Project
ProjectMemberController --> ProjectMember
TaskController          --> Task
TaskAssigneeController  --> TaskAssignee

AuthRoutes          .up.> AuthMiddleware
ProjectRoutes       .up.> AuthMiddleware
ProjectRoutes       .up.> PermissionMiddleware
ProjectMemberRoutes .up.> PermissionMiddleware
TaskRoutes          .up.> AuthMiddleware
TaskRoutes          .up.> PermissionMiddleware
TaskAssigneeRoutes  .up.> AuthMiddleware

User        --> Database
Project     --> Database
ProjectMember --> Database
Task        --> Database
TaskAssignee --> Database

App --> ErrorMiddleware
Server --> App

@enduml