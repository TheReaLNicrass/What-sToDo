# Server
PORT=3000

# Session – unbedingt einen eigenen geheimen Wert setzen, nicht den Default verwenden!
SESSION_SECRET=dein_geheimer_session_schluessel

# Datenbank
# Lokal ohne Docker: localhost, Port 5432, eigene DB
# Mit Docker Compose: DB_HOST=db (Name des Postgres-Service aus docker-compose.yml)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=whatstodo
DB_USER=dev
DB_PASSWORD=devpassword
